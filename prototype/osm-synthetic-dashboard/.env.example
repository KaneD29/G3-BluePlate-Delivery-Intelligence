# BluePlate local Flask / MySQL integration example; do not commit real .env
BLUEPLATE_ENV=development
FLASK_PORT=5000
FLASK_DEBUG=false
# When frontend/ is merged beside etl/ and web_app_example/, Flask can serve it
# FRONTEND_DIR=/absolute/path/to/frontend

# Existing ETL database user (needs warehouse write privileges)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=blueplate_etl
MYSQL_PASSWORD=replace_with_etl_password
MYSQL_DATABASE=blueplate_dw

# Local Flask app database user; production needs a least-privilege separate account.
APP_DB_HOST=127.0.0.1
APP_DB_PORT=3306
APP_DB_USER=blueplate_app
APP_DB_PASSWORD=replace_with_app_password
APP_DB_DATABASE=blueplate_dw

# Collector: leave unset to disable Google Places ETL
GOOGLE_PLACES_API_KEY=
UST_CENTER_LAT=14.6091
UST_CENTER_LNG=120.9895
UST_SEARCH_RADIUS_METERS=1500

# Disabled by default. For controlled local development ONLY:
ENABLE_GUEST_REPORTS=false
# Set a random secret of at least 32 characters in the Flask process environment.
BLUEPLATE_GUEST_SESSION_SECRET=
# Production stays OFF until HTTPS, Nginx limits and Turnstile are verified in staging.
ENABLE_PRODUCTION_GUEST_REPORTS=false
# Exact lowercase HTTPS origin, without a port, path or trailing slash.
BLUEPLATE_PUBLIC_ORIGIN=
# Supported production topology: one TLS ingress on this host. IP describes the
# immediate upstream TCP peer seen by Flask, not the browser.
BLUEPLATE_TRUSTED_PROXY_HOPS=
BLUEPLATE_TRUSTED_PROXY_IP=
# Obtain keys for the exact public hostname. Only the site key is browser-visible.
BLUEPLATE_TURNSTILE_SITE_KEY=
BLUEPLATE_TURNSTILE_SECRET_KEY=
# Requires an existing active ADMIN/BI_MANAGER/OPERATIONS_ANALYST user ID.
# The 24+-character bearer token must NEVER be embedded in frontend code.
ENABLE_DEMO_MANAGER_TOKEN=false
MANAGER_USER_ID=
MANAGER_API_TOKEN=
