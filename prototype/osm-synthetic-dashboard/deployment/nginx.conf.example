# Render with the staging hostname and approved certificate paths.
limit_req_zone $binary_remote_addr zone=blueplate_guest:10m rate=6r/m;
server {
    listen 443 ssl;
    server_name blueplate.example.org;
    ssl_certificate /etc/ssl/blueplate/fullchain.pem;
    ssl_certificate_key /etc/ssl/blueplate/privkey.pem;
    client_max_body_size 16k;
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location = /api/user/reviews {
        limit_req zone=blueplate_guest burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
